# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.pem
*.key
*.token

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Apache Airflow Local Execution & Logs
**/logs/
logs/
airflow-logs/
airflow.cfg
**/config/airflow.cfg
airflow.db
webserver_config.py
standalone_admin_password.txt

# Data Directories & Local CSV/Parquet dumps
data/*.csv
data/*.parquet
data/*.json
!data/.gitkeep
AWS_Project_Airflow/data/*.csv
AWS_Project_Airflow/data/*.parquet
AWS_Project_Airflow/data/*.json
!AWS_Project_Airflow/data/.gitkeep

